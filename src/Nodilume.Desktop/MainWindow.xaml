<Window x:Class="Nodilume.Desktop.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:wv="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
 Title="Nodilume — Le mie mappe" Width="1280" Height="820"
 MinWidth="860" MinHeight="600" Background="#0A111B" WindowStartupLocation="CenterScreen">
 <DockPanel>
  <Border DockPanel.Dock="Top" Background="#152536" Padding="12,8">
   <Grid>
    <Grid.ColumnDefinitions>
     <ColumnDefinition Width="Auto"/>
     <ColumnDefinition Width="2*"/>
     <ColumnDefinition Width="2*"/>
     <ColumnDefinition Width="Auto"/>
     <ColumnDefinition Width="Auto"/>
    </Grid.ColumnDefinitions>
    <TextBlock Grid.Column="0" Text="Mappa" Foreground="#D6E7F5" VerticalAlignment="Center" Margin="0,0,10,0"/>
    <ComboBox Grid.Column="1" x:Name="MapPicker" MinWidth="160" Margin="0,0,12,0"
      SelectionChanged="MapPicker_SelectionChanged" AutomationProperties.Name="Mappa attiva"/>
    <TextBox Grid.Column="2" x:Name="MapNameInput" MaxLength="120" Margin="0,0,12,0"
      VerticalContentAlignment="Center" ToolTip="Nome per nuova mappa o rinomina"/>
    <Button Grid.Column="3" x:Name="NewMapButton" Content="Nuova mappa" Padding="12,5"
      Margin="0,0,8,0" Click="NewMapButton_Click"/>
    <Button Grid.Column="4" x:Name="RenameMapButton" Content="Rinomina" Padding="12,5"
      Click="RenameMapButton_Click"/>
   </Grid>
  </Border>
  <Border DockPanel.Dock="Bottom" Background="#101C29" Padding="16,7">
   <StackPanel Orientation="Horizontal">
    <TextBlock x:Name="MapStatus" Foreground="#90D8D0" FontSize="12" Margin="0,0,20,0"
      Text="Catalogo in caricamento…"/>
    <TextBlock x:Name="Status" Foreground="#B6C7D7" Text="Avvio della vista…" FontSize="12" />
   </StackPanel>
  </Border>
  <wv:WebView2 x:Name="Viewer" DefaultBackgroundColor="#0A111B" />
 </DockPanel>
</Window>
